{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/servicos", "destination": "/servicos/index.html" },
    { "source": "/galeria", "destination": "/galeria/index.html" },
    { "source": "/equipe", "destination": "/equipe/index.html" },
    { "source": "/agendamento", "destination": "/agendamento/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
